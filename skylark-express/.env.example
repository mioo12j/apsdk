# Leave a value empty to use that tool's phone/email fallback.
PUBLIC_SITE_MODE=production            # "preview" enables the labelled local test API and noindex
PUBLIC_TRACKING_ENDPOINT=              # GET  {endpoint}?number=DOCKET[,DOCKET]   → see docs/INTEGRATIONS.md
PUBLIC_POD_ENDPOINT=                   # POST {endpoint} {number, verification}   → authorised POD link
PUBLIC_PIN_ENDPOINT=                   # GET  {endpoint}?pin=110015
PUBLIC_FORMS_ENDPOINT=                 # POST {endpoint} JSON enquiry             → {reference}
PUBLIC_CUSTOMER_PORTAL_URL=            # approved customer login link
PUBLIC_CAREERS_UPLOAD_ENDPOINT=        # approved application/CV upload backend
