---
import Pic from './Pic.astro';
import { founders } from '../data/company';
interface Props { size?: 'home' | 'about' }
const { size = 'home' } = Astro.props;
---
<div class:list={['founders', size]}>
  {founders.map((f, i) => (
    <figure class="founder" data-reveal style={`--d:${i * 120}ms`}>
      <div class="f-frame">
        <Pic name={`${f.portrait}-crop`} alt={f.alt} ratio={4 / 5} widths={[336, 672]} sizes="(min-width:900px) 300px, 44vw" quality={80} />
      </div>
      <figcaption>
        <span class="f-name display">{f.name}</span>
        <span class="f-title">{f.title}</span>
        <span class="f-resp">{f.responsibility}</span>
      </figcaption>
    </figure>
  ))}
</div>
<style>
  .founders{display:grid;grid-template-columns:1fr 1fr;gap:16px}
  @media (min-width:900px){.founders{gap:24px}}
  .founder{display:grid;gap:14px;align-content:start}
  .f-frame{position:relative;aspect-ratio:4/5;background:var(--paper-2);overflow:hidden}
  .f-frame :global(img){width:100%;height:100%;object-fit:cover;display:block}
  .f-frame::after{content:"";position:absolute;inset:0;border:1px solid rgba(246,244,238,.55);pointer-events:none;transition:inset .8s var(--ease) calc(var(--d,0ms) + .25s)}
  :global(.js) .founder[data-reveal]:not(.in) .f-frame::after{inset:14px}
  figcaption{display:grid;gap:3px;margin:0;color:inherit;position:relative;padding-left:14px;font-size:1rem}
  figcaption::before{content:"";position:absolute;left:0;top:4px;bottom:4px;width:3px;background:var(--citron)}
  .f-name{font-size:clamp(1.25rem,1rem + 1.2vw,1.875rem);line-height:1}
  .f-title{font-weight:600}
  .f-resp{font-size:.9375rem;opacity:.85}
  @media (max-width:420px){.f-title,.f-resp{font-size:.875rem}}
</style>
