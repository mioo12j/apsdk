---
import Logo from './Logo.astro';
import { mainNav, companyNav } from '../data/site';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const cur = (href: string) => (path === href || (href !== '/' && path.startsWith(href + '/')) ? 'page' : undefined);
---
<header class="site-header dark" data-header>
  <div class="wrap bar">
    <a class="brand" href="/" aria-label="Skylark Express home"><Logo /></a>
    <nav class="nav" aria-label="Primary">
      {mainNav.map((l) => <a href={l.href} aria-current={cur(l.href)}>{l.label}</a>)}
      <div class="has-menu">
        <button class="nav-btn" type="button" aria-expanded="false" aria-controls="company-menu" data-submenu-btn>Company <svg width="10" height="6" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6"/></svg></button>
        <div class="submenu" id="company-menu" data-submenu>
          {companyNav.map((l) => <a href={l.href} aria-current={cur(l.href)}>{l.label}</a>)}
        </div>
      </div>
      <a class="btn btn-ghost" href="/track" aria-current={cur('/track')}>Track</a>
      <a class="btn btn-primary" href="/quote" aria-current={cur('/quote')}>Get a quote</a>
    </nav>
    <div class="header-tools">
      <button class="icon-btn" type="button" data-search-open aria-label="Search the site">
        <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="6" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M13 13l5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      </button>
      <a class="icon-btn m-track m-only" href="/track">Track</a>
      <button class="icon-btn m-only" type="button" aria-expanded="false" aria-controls="m-menu" data-menu-btn>
        <span data-menu-label>Menu</span>
        <svg width="20" height="14" viewBox="0 0 20 14" aria-hidden="true"><path d="M0 1h20M0 7h20M0 13h20" stroke="currentColor" stroke-width="1.8"/></svg>
      </button>
    </div>
  </div>
  <div class="m-menu" id="m-menu" data-menu>
    <nav aria-label="Menu">
      <a href="/track">Track a shipment <span aria-hidden="true">→</span></a>
      <a href="/quote">Get a freight quote <span aria-hidden="true">→</span></a>
      {mainNav.map((l) => <a href={l.href}>{l.label} <span aria-hidden="true">→</span></a>)}
      <a href="/serviceability">Check a PIN code <span aria-hidden="true">→</span></a>
      <div class="sub" role="group" aria-label="Company">
        {companyNav.map((l) => <a href={l.href}>{l.label}</a>)}
        <a href="/help">Help and FAQs</a>
      </div>
      <div class="m-actions">
        <a class="btn-primary" href="/quote" style="background:var(--citron);border-color:var(--citron)">Get a freight quote</a>
        <a href="tel:+911141666666">Call +91 11 4166 6666</a>
      </div>
    </nav>
  </div>
</header>
