---
// India network map. Boundaries are rendered from the checked vector geometry in
// src/data/generated/india-map.json (see map-src/ and scripts/build-map.mjs) — never from generated imagery.
import { map, markers, markersNarrow, hqPoint } from '../data/mapgeo';
interface Props { id?: string; routes?: boolean; theme?: 'dark' | 'paper'; anim?: boolean }
const { id = 'india-map', routes = true, theme = 'dark', anim = true } = Astro.props;
const W = map.width, H = map.height;
const dist = (d: number[]) => Math.hypot(d[0] - hqPoint[0], d[1] - hqPoint[1]);
const maxD = Math.max(...map.dots.map(dist));
const routeTo = markers.filter((m) => !m.hq).map((m) => {
  const [x0, y0] = hqPoint; const dx = m.x - x0, dy = m.y - y0; const len = Math.hypot(dx, dy);
  const cx = x0 + dx / 2 - dy * 0.16, cy = y0 + dy / 2 + dx * 0.16;
  return { d: `M${x0.toFixed(1)},${y0.toFixed(1)} Q${cx.toFixed(1)},${cy.toFixed(1)} ${m.x},${m.y}`, len: Math.round(len * 1.08), delay: Math.round(len * 1.6), pub: m.published };
});
const lak = map.dots[map.dots.length - 9], an = map.dots[map.dots.length - 6];
---
<div class:list={['imap', theme]} data-map data-anim={anim ? '' : undefined} id={id}>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby={`${id}-t ${id}-d`} preserveAspectRatio="xMidYMid meet">
    <title id={`${id}-t`}>Map of India showing Skylark Express listed locations</title>
    <desc id={`${id}-d`}>A dotted map of India with north at the top, showing the corporate headquarters in Gurugram and {markers.length} marked city groups. The same locations are listed in the text directory.</desc>
    <g class="dots">{map.dots.map((d) => <circle cx={d[0]} cy={d[1]} r="2.7" style={`--dd:${Math.round((dist(d) / maxD) * 900)}ms`} />)}</g>
    <path class="inner" d={map.inner} />
    <path class="outline" d={map.outline} pathLength="1" />
    {routes && <g class="routes">{routeTo.map((r) => <path d={r.d} style={`--len:${r.len};--rd:${r.delay}ms`} class={r.pub ? 'pub' : ''} />)}</g>}
    <g class="isl" aria-hidden="true">
      <text x={lak[0] + 14} y={lak[1] + 34} text-anchor="middle">Lakshadweep</text>
      <text x={an[0] - 16} y={an[1] - 62} text-anchor="end">Andaman &amp;</text>
      <text x={an[0] - 16} y={an[1] - 44} text-anchor="end">Nicobar Islands</text>
      <g transform={`translate(${W - 54},54)`}><path d="M0,-26 L7,0 L0,-5 L-7,0 Z" /><text y="18" text-anchor="middle">N</text></g>
    </g>
  </svg>
  {[['wide', markers], ['narrow', markersNarrow]].map(([scale, list]) => (
    <div class={`pins pins-${scale}`}>
      {(list as typeof markers).map((m) => (
        <button type="button" class:list={['pin', { hq: m.hq, cluster: m.members.length > 1, city: !m.published }]} style={`left:${(m.x / W) * 100}%;top:${(m.y / H) * 100}%`}
          data-pin={m.id} aria-label={`${m.label}${m.published ? '' : ' (city location)'}`} aria-pressed="false">
          <span class="dot" aria-hidden="true">{m.members.length > 1 ? m.members.length : ''}</span>
          {m.hq && <span class="pin-label" aria-hidden="true">Gurugram HQ</span>}
        </button>
      ))}
    </div>
  ))}
</div>
<style>
  .imap{position:relative;width:100%;max-width:640px;margin-inline:auto;aspect-ratio:1000/1151;container-type:inline-size}
  .pins-narrow{display:none}
  @container (max-width:479px){.pins-wide{display:none}.pins-narrow{display:block}}
  .imap svg{width:100%;height:100%;overflow:visible}
  .dots circle{fill:var(--cyan);opacity:.5}
  .paper .dots circle{fill:var(--link);opacity:.42}
  .outline{fill:none;stroke:var(--paper);stroke-width:1.6;stroke-linejoin:round;vector-effect:non-scaling-stroke}
  .paper .outline{stroke:var(--ink)}
  .inner{fill:none;stroke:var(--paper);stroke-width:.7;opacity:.3;vector-effect:non-scaling-stroke}
  .paper .inner{stroke:var(--ink);opacity:.28}
  .routes path{fill:none;stroke:var(--cyan);stroke-width:1.2;opacity:.55;vector-effect:non-scaling-stroke;stroke-dasharray:3 5}
  .routes path.pub{stroke:var(--citron);opacity:.95;stroke-dasharray:none;stroke-width:1.5}
  .paper .routes path{stroke:var(--link)} .paper .routes path.pub{stroke:var(--ink)}
  .isl text{font:600 17px var(--body);fill:var(--muted-dark);letter-spacing:.04em}
  .isl path{fill:var(--muted-dark)}
  .paper .isl text{fill:var(--muted)} .paper .isl path{fill:var(--muted)}
  .pins{position:absolute;inset:0}
  .pin{position:absolute;transform:translate(-50%,-50%);width:26px;height:26px;border:0;background:none;padding:0;display:grid;place-items:center;border-radius:50%}
  .pin .dot{display:grid;place-items:center;min-width:14px;height:14px;border-radius:50%;background:var(--paper);border:2px solid var(--navy);font:700 11px/1 var(--body);color:var(--navy);transition:transform .2s var(--ease),background-color .2s}
  .pin.city .dot{background:var(--navy);border-color:var(--cyan);min-width:11px;height:11px}
  .paper .pin.city .dot{background:var(--paper);border-color:var(--link)}
  .paper .pin .dot{background:var(--ink);color:var(--paper);border-color:var(--paper)}
  .pin.cluster .dot{min-width:22px;height:22px;padding:0 4px}
  .pin.hq .dot{background:var(--citron);border-color:var(--navy);min-width:26px;height:26px;color:var(--ink);box-shadow:0 0 0 5px rgba(213,239,68,.28)}
  .pin:hover .dot,.pin[aria-pressed="true"] .dot{transform:scale(1.35);background:var(--citron);color:var(--ink);border-color:var(--navy)}
  .pin:focus-visible{outline:3px solid var(--citron);outline-offset:2px}
  .pin.hq .dot{position:relative}
  .pin.hq .dot::after{content:"";position:absolute;inset:-3px;border-radius:50%;border:2px solid var(--citron);animation:hqPulse 2.6s ease-out infinite;pointer-events:none}
  @keyframes hqPulse{0%{transform:scale(1);opacity:.95}100%{transform:scale(2.8);opacity:0}}
  .paper .pin:focus-visible{outline-color:var(--link)}
  .pin-label{position:absolute;left:calc(50% + 22px);top:50%;transform:translateY(-50%);white-space:nowrap;font:600 .75rem/1 var(--body);letter-spacing:.06em;text-transform:uppercase;background:var(--citron);color:var(--ink);padding:5px 8px;border-radius:3px;pointer-events:none}
  @media (prefers-reduced-motion:no-preference){
    :global(.js) .imap[data-anim] .dots circle{opacity:0;transition:opacity .5s var(--ease) var(--dd)}
    :global(.js) .imap[data-anim] .outline{stroke-dasharray:1;stroke-dashoffset:1;transition:stroke-dashoffset 2.2s var(--ease) .1s}
    :global(.js) .imap[data-anim] .routes path.pub{stroke-dasharray:var(--len);stroke-dashoffset:var(--len);transition:stroke-dashoffset 1.1s var(--ease) calc(900ms + var(--rd))}
    :global(.js) .imap[data-anim] .routes path:not(.pub){opacity:0;transition:opacity .8s var(--ease) calc(1200ms + var(--rd))}
    :global(.js) .imap[data-anim] .pin{opacity:0;transition:opacity .4s var(--ease) 1.2s}
    :global(.js) .imap[data-anim] .pin.hq{opacity:1}
    :global(.js) .imap[data-anim].in .dots circle{opacity:.5}
    :global(.js) .imap.paper[data-anim].in .dots circle{opacity:.42}
    :global(.js) .imap[data-anim].in .outline{stroke-dashoffset:0}
    :global(.js) .imap[data-anim].in .routes path.pub{stroke-dashoffset:0}
    :global(.js) .imap[data-anim].in .routes path:not(.pub){opacity:.55}
    :global(.js) .imap[data-anim].in .pin{opacity:1}
  }
</style>
