---
// Simple, labelled process diagrams for the service pages (inline SVG, readable without colour).
interface Props { kind: string }
const { kind } = Astro.props;
const flows: Record<string, { title: string; nodes: [string, string][] }> = {
  rail: { title: 'Where road hands over to rail and back again', nodes: [['Road', 'Pickup from shipper'], ['Handover', 'Origin rail terminal'], ['Rail', 'Consolidated rail leg'], ['Handover', 'Destination terminal'], ['Road', 'Delivery to consignee']] },
  air: { title: 'Air consignment milestones', nodes: [['Brief', 'Cut-off, dimensions, handling'], ['Pickup', 'Collected by road'], ['Uplift', 'Accepted by the carrier'], ['Arrival', 'Destination airport'], ['Delivery', 'By road, with POD']] },
  warehouse: { title: 'Intake, storage and dispatch', nodes: [['Intake', 'Inbound check, SKU receipt'], ['Storage', 'Put-away, FIFO rotation'], ['Dispatch', 'Pick, pack, distribute']] },
  odc: { title: 'Planning an over-dimensional movement', nodes: [['Measure', 'Dimensions and weight'], ['Survey', 'Route and site access'], ['Permit', 'Approvals and trailer'], ['Move', 'Supervised, escorted']] },
  packaging: { title: 'From assessment to a closed crate', nodes: [['Assess', 'Fragility and conditions'], ['Specify', 'Material and method'], ['Pack', 'Seal, label, hand over']] },
};
const f = flows[kind];
---
{kind === 'ftl-ptl' ? (
  <figure class="dia">
    <svg viewBox="0 0 720 300" role="img" aria-labelledby="dia-t dia-d">
      <title id="dia-t">Full Truck Load compared with Part Truck Load</title>
      <desc id="dia-d">In a Full Truck Load one shipper’s cargo fills the vehicle and travels direct. In a Part Truck Load three shippers’ consignments share the vehicle’s capacity.</desc>
      <g font-family="Inter,system-ui,sans-serif" fill="#102532">
        <text x="0" y="22" font-weight="600" font-size="15" letter-spacing="1.5">FTL · ONE SHIPPER, WHOLE VEHICLE</text>
        <rect x="0" y="38" width="470" height="84" fill="none" stroke="#102532" stroke-width="2"/>
        <rect x="8" y="46" width="454" height="68" fill="#006780"/><text x="235" y="86" fill="#F6F4EE" text-anchor="middle" font-size="15" font-weight="600">Shipper A</text>
        <path d="M470 62h70l40 34v26h-110z" fill="none" stroke="#102532" stroke-width="2"/><circle cx="90" cy="130" r="13" fill="#102532"/><circle cx="380" cy="130" r="13" fill="#102532"/><circle cx="540" cy="130" r="13" fill="#102532"/>
        <text x="600" y="86" font-size="14">Direct, door to door</text>
        <text x="0" y="182" font-weight="600" font-size="15" letter-spacing="1.5">PTL · SHARED CAPACITY</text>
        <rect x="0" y="198" width="470" height="84" fill="none" stroke="#102532" stroke-width="2"/>
        <rect x="8" y="206" width="170" height="68" fill="#006780"/><text x="93" y="246" fill="#F6F4EE" text-anchor="middle" font-size="15" font-weight="600">Shipper A</text>
        <rect x="184" y="206" width="150" height="68" fill="#D5EF44" stroke="#102532"/><text x="259" y="246" text-anchor="middle" font-size="15" font-weight="600">Shipper B</text>
        <rect x="340" y="206" width="122" height="68" fill="#F6F4EE" stroke="#102532" stroke-dasharray="5 4"/><text x="401" y="246" text-anchor="middle" font-size="15" font-weight="600">Shipper C</text>
        <path d="M470 222h70l40 34v26h-110z" fill="none" stroke="#102532" stroke-width="2"/><circle cx="90" cy="290" r="10" fill="#102532"/><circle cx="380" cy="290" r="10" fill="#102532"/><circle cx="540" cy="290" r="10" fill="#102532"/>
        <text x="600" y="246" font-size="14">Via hubs, pay for</text><text x="600" y="264" font-size="14">space used</text>
      </g>
    </svg>
    <figcaption>Two loading arrangements. Lane, load size and frequency decide which suits a consignment.</figcaption>
  </figure>
) : (
  <figure class="dia">
    <ol class="flow" role="list" aria-label={f.title}>
      {f.nodes.map(([k, t], i) => <li class:list={{ hand: k === 'Handover' }}><span class="mono flow-n">{String(i + 1).padStart(2, '0')}</span><strong>{k}</strong><span>{t}</span></li>)}
    </ol>
    <figcaption>{f.title}.</figcaption>
  </figure>
)}
<style>
  .dia{border:1px solid var(--rule-strong);padding:clamp(16px,2.4vw,28px);background:#fff}
  .dia svg{width:100%;height:auto;min-width:0}
  .flow{display:grid;gap:0}
  .flow li{display:grid;grid-template-columns:auto 1fr;gap:2px 12px;padding:14px 0 14px 0;border-top:1px solid var(--rule);position:relative}
  .flow li:first-child{border-top:0}
  .flow-n{grid-row:1/3;color:var(--link);font-size:.875rem;padding-top:3px}
  .flow strong{font:700 1.375rem/1 var(--display)}
  .flow span:last-child{color:var(--muted);font-size:.9375rem}
  .flow li.hand strong::after{content:" ⇄";color:var(--link)}
  @media (min-width:820px){
    .flow{grid-auto-flow:column;grid-auto-columns:1fr}
    .flow li{grid-template-columns:1fr;border-top:0;border-left:1px solid var(--rule);padding:6px 14px 6px 16px}
    .flow li:first-child{border-left:0;padding-left:0}
    .flow-n{grid-row:auto}
    .flow li:not(:last-child)::after{content:"→";position:absolute;right:-9px;top:26px;background:#fff;color:var(--ink);font-weight:700;z-index:1}
  }
</style>
