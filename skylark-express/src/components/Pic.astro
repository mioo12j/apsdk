---
// Responsive picture: AVIF + WebP + JPEG fallback, explicit dimensions, lazy by default.
import { getImage } from 'astro:assets';
const all = import.meta.glob('../assets/img/*.{jpg,png}', { eager: true }) as Record<string, { default: ImageMetadata }>;
interface Props { name: string; alt: string; sizes?: string; widths?: number[]; ratio?: number; priority?: boolean; class?: string; position?: string; quality?: number }
const { name, alt, sizes = '100vw', widths = [480, 800, 1200, 1600, 2200], ratio, priority = false, class: cls, position, quality = 62 } = Astro.props;
const key = Object.keys(all).find((k) => k.endsWith(`/${name}.jpg`) || k.endsWith(`/${name}.png`));
if (!key) throw new Error(`Pic: image "${name}" not found`);
const src = all[key].default;
const ws = widths.filter((w) => w <= src.width);
if (!ws.length) ws.push(src.width);
const hFor = (w: number) => Math.round(ratio ? w / ratio : (w * src.height) / src.width);
const make = async (format: 'avif' | 'webp' | 'jpeg', q: number) =>
  (await Promise.all(ws.map(async (w) => { const i = await getImage({ src, width: w, height: hFor(w), format, quality: q, fit: 'cover', position: position as any }); return `${i.src} ${w}w`; }))).join(', ');
const avif = await make('avif', Math.max(40, quality - 12));
const webp = await make('webp', quality);
const fbW = ws[Math.min(ws.length - 1, 2)];
const fb = await getImage({ src, width: fbW, height: hFor(fbW), format: 'jpeg', quality: 72, fit: 'cover', position: position as any });
---
<picture>
  <source type="image/avif" srcset={avif} sizes={sizes} />
  <source type="image/webp" srcset={webp} sizes={sizes} />
  <img src={fb.src} width={fbW} height={hFor(fbW)} alt={alt} class={cls} loading={priority ? 'eager' : 'lazy'} decoding={priority ? 'sync' : 'async'} fetchpriority={priority ? 'high' : undefined} style={position ? `object-position:${position}` : undefined} />
</picture>
