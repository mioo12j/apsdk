---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Pic from '../../components/Pic.astro';
import CTA from '../../components/CTA.astro';
import { services } from '../../data/services';
---
<Base title="Logistics Services: Road, Rail, Air, Storage" description="Six logistics services from Skylark Express: FTL and PTL road freight, rail and air cargo, warehousing, project cargo and specialist packaging across India.">
  <PageHero video="road" cut={["train", "truck", "plane"]} eyebrow="Six service lines" title="What are you moving?" lede="Start with your situation. The selector points you to the service that fits; every page ends with an enquiry that goes to the right team." />
  <section class="section-tight" aria-labelledby="sel-h">
    <div class="wrap">
      <h2 class="display h-2" id="sel-h">Service selector</h2>
      <p class="muted" style="margin-top:6px">Choose the statement closest to your requirement.</p>
      <div class="sel" role="group" aria-label="Choose your situation" data-selector>
        {services.map((s, i) => <button type="button" class="sel-btn" aria-pressed={i === 0 ? 'true' : 'false'} data-sel={s.slug}>“{s.selector}”</button>)}
      </div>
      <div aria-live="polite" class="sel-out">
        {services.map((s, i) => (
          <article class="sel-card" data-sel-card={s.slug} hidden={i !== 0}>
            <div class="sel-pic"><Pic name={s.image} alt={s.imageAlt} ratio={3 / 2} widths={[480, 800, 1200]} sizes="(min-width:900px) 44vw, 92vw" /></div>
            <div class="stack" style="--s:14px">
              <p class="eyebrow">Suggested service · {s.index}</p>
              <h3 class="display h-1">{s.name}</h3>
              <p class="lede">{s.lede}</p>
              <p class="cluster"><a class="btn btn-ink" href={`/services/${s.slug}`}>See how {s.short.toLowerCase()} works <span class="arr" aria-hidden="true">→</span></a><a class="link-arrow" href={`/quote?service=${s.slug}`}>Discuss this shipment <span class="arr" aria-hidden="true">→</span></a></p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section class="section-tight rule-top" aria-labelledby="all-h">
    <div class="wrap">
      <h2 class="display h-2" id="all-h">All services</h2>
      <ul class="all" role="list">
        {services.map((s) => (
          <li data-reveal>
            <a href={`/services/${s.slug}`} class="all-a" data-tilt>
              <span class="all-pic"><Pic name={s.image} alt="" ratio={4 / 3} widths={[400, 700]} sizes="(min-width:900px) 30vw, (min-width:600px) 46vw, 92vw" /></span>
              <span class="mono small">{s.index}</span>
              <span class="display h-2">{s.name}</span>
              <span class="muted">{s.summary}</span>
            </a>
          </li>
        ))}
      </ul>
      <p style="margin-top:28px">Tracking, digital dockets and proof of delivery are explained on the <a href="/technology">Technology</a> page.</p>
    </div>
  </section>
  <CTA />
  <script>
    document.querySelectorAll<HTMLAnchorElement>('.all-a').forEach((a) => a.addEventListener('click', () => { const i = a.querySelector<HTMLElement>('.all-pic img'); if (i) i.style.viewTransitionName = 'service-hero'; }));
    addEventListener('pageshow', () => document.querySelectorAll<HTMLElement>('.all-pic img').forEach((i) => (i.style.viewTransitionName = '')));
    const root = document.querySelector('[data-selector]');
    root?.querySelectorAll<HTMLButtonElement>('[data-sel]').forEach((b) => b.addEventListener('click', () => {
      root.querySelectorAll('[data-sel]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      document.querySelectorAll<HTMLElement>('[data-sel-card]').forEach((c) => (c.hidden = c.dataset.selCard !== b.dataset.sel));
    }));
  </script>
</Base>
<style>
  .sel{display:grid;gap:10px;margin-top:20px}
  @media (min-width:700px){.sel{grid-template-columns:repeat(2,1fr)}}
  @media (min-width:1100px){.sel{grid-template-columns:repeat(3,1fr)}}
  .sel-btn{text-align:left;min-height:64px;padding:14px 16px;background:#fff;border:1.5px solid var(--rule-strong);border-radius:var(--r);font-weight:500;transition:border-color .16s,background-color .16s}
  .sel-btn:hover{border-color:var(--ink)}
  .sel-btn[aria-pressed="true"]{background:var(--ink);color:var(--paper);border-color:var(--ink);box-shadow:inset 6px 0 0 var(--citron)}
  .sel-out{margin-top:28px}
  .sel-card{display:grid;gap:24px;align-items:center}
  @media (min-width:900px){.sel-card{grid-template-columns:1fr 1fr;gap:48px}}
  .sel-pic :global(img){width:100%}
  .all{display:grid;gap:32px 24px;margin-top:24px}
  @media (min-width:600px){.all{grid-template-columns:repeat(2,1fr)}}
  @media (min-width:900px){.all{grid-template-columns:repeat(3,1fr)}}
  .all-a{position:relative;display:grid;gap:6px;text-decoration:none;color:var(--ink);padding:10px;margin:-10px;border-radius:6px}
  .all-pic{overflow:hidden;margin-bottom:8px;display:block}
  .all-pic :global(img){width:100%;transition:transform .7s var(--ease)}
  .all-a:hover .all-pic :global(img){transform:scale(1.04)}
  .all-a:hover .display{text-decoration:underline;text-decoration-thickness:3px;text-decoration-color:var(--citron);text-underline-offset:6px}
</style>
