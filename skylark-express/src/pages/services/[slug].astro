---
import Base from '../../layouts/Base.astro';
import Pic from '../../components/Pic.astro';
import Diagram from '../../components/Diagram.astro';
import { services } from '../../data/services';
import { ORIGIN } from '../../data/site';
export function getStaticPaths() { return services.map((s) => ({ params: { slug: s.slug }, props: { s } })); }
const { s } = Astro.props;
const others = services.filter((x) => x.slug !== s.slug);
const jsonld = [{ '@context': 'https://schema.org', '@type': 'Service', name: s.name, serviceType: s.name, description: s.summary, areaServed: 'IN', provider: { '@id': ORIGIN + '/#organization' }, url: `${ORIGIN}/services/${s.slug}` }];
---
<Base title={s.name} description={s.lede} jsonld={jsonld}>
  <section class="sd-hero dark">
    <div class="sd-pic"><Pic name={s.image} alt={s.imageAlt} priority sizes="100vw" widths={[640, 1024, 1600, 2200]} /></div>
    <div class="wrap sd-hero-in">
      <nav aria-label="Breadcrumb"><ol class="crumbs" role="list"><li><a href="/">Home</a></li><li><a href="/services">Services</a></li></ol></nav>
      <p class="mono sd-idx">{s.index} / 06</p>
      <h1 class="display h-hero">{s.name}</h1>
    </div>
  </section>
  <section class="section-tight">
    <div class="wrap grid">
      <div class="sd-lede"><p class="lede">{s.lede}</p>
        <p class="cluster" style="margin-top:20px"><a class="btn btn-primary" href={`/quote?service=${s.slug}`}>Discuss this shipment <span class="arr" aria-hidden="true">→</span></a><a class="link-arrow" href="/track">Track a shipment <span class="arr" aria-hidden="true">→</span></a></p>
      </div>
      <dl class="spec sd-spec">{s.spec.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
    </div>
  </section>
  <section class="section-tight rule-top">
    <div class="wrap grid">
      <h2 class="display h-2 sd-h">How it works</h2>
      <div class="sd-body">{s.body.map((b) => <div data-reveal><h3 class="display h-3">{b.heading}</h3><p>{b.text}</p></div>)}</div>
    </div>
  </section>
  {s.categories && (
    <section class="section-tight rule-top" aria-labelledby="cat-h">
      <div class="wrap grid">
        <h2 class="display h-2 sd-h" id="cat-h">Eight packaging categories</h2>
        <ol class="cats" role="list">{s.categories.map((c, i) => <li data-reveal><span class="mono small">{String(i + 1).padStart(2, '0')}</span><h3 class="display h-3">{c.name}</h3><p class="muted">{c.text}</p></li>)}</ol>
      </div>
    </section>
  )}
  <section class="section-tight rule-top">
    <div class="wrap grid">
      <h2 class="display h-2 sd-h">{s.diagram === 'ftl-ptl' ? 'FTL and PTL compared' : 'The handling sequence'}</h2>
      <div class="sd-body one"><Diagram kind={s.diagram} />
        {s.diagram === 'ftl-ptl' && <ol class="seq" role="list">{s.sequence.map((q, i) => <li><span class="mono small">{String(i + 1).padStart(2, '0')}</span><strong class="display h-3">{q.step}</strong><span>{q.text}</span></li>)}</ol>}
      </div>
    </div>
  </section>
  <section class="section-tight rule-top">
    <div class="wrap grid">
      <h2 class="display h-2 sd-h">Suitable cargo</h2>
      <ul class="suits" role="list">{s.suits.map((x) => <li>{x}</li>)}</ul>
    </div>
  </section>
  <section class="section-tight petrol" aria-labelledby="enq-h">
    <div class="wrap grid">
      <div class="sd-h stack" style="--s:12px"><h2 class="display h-1" id="enq-h">Discuss this shipment</h2><p>Tell us a few things about the load. The service is carried into the quote form for you.</p></div>
      <form class="sd-enq" action="/quote" method="get">
        <input type="hidden" name="service" value={s.slug} />
        {s.enquiry.map((f) => <div class="field"><label for={`e-${f.id}`}>{f.label} <span class="opt" style="color:var(--muted-dark)">(optional)</span></label><input class="input" id={`e-${f.id}`} name={f.id} type={f.type || 'text'} />{f.hint && <p class="hint" style="color:var(--muted-dark)">{f.hint}</p>}</div>)}
        <button class="btn btn-primary" type="submit">Discuss this shipment <span class="arr" aria-hidden="true">→</span></button>
      </form>
    </div>
  </section>
  <section class="section-tight">
    <div class="wrap">
      <h2 class="display h-2">Other services</h2>
      <ul class="others" role="list">{others.map((o) => <li><a href={`/services/${o.slug}`}><span class="mono small">{o.index}</span> <span class="display h-3">{o.name}</span></a></li>)}</ul>
      <p style="margin-top:20px">See how tracking and proof of delivery work on the <a href="/technology">Technology</a> page.</p>
    </div>
  </section>
</Base>
<style>
  .sd-hero{position:relative;isolation:isolate;min-height:min(64vh,640px);display:grid;align-items:end;overflow:clip}
  .sd-pic{position:absolute;inset:0;z-index:-1}
  .sd-pic :global(img){width:100%;height:100%;object-fit:cover;view-transition-name:service-hero}
  .sd-hero::after{content:"";position:absolute;inset:0;z-index:-1;background:linear-gradient(0deg,rgba(11,32,44,.92) 0%,rgba(11,32,44,.35) 55%,rgba(11,32,44,.25) 100%)}
  .sd-hero-in{padding-block:28px clamp(24px,4vw,48px);display:grid;gap:10px}
  .sd-idx{color:var(--citron)}
  .sd-lede{grid-column:1/-1}
  .sd-spec{grid-column:1/-1;margin-top:28px;background:#fff;align-self:start}
  .sd-h{grid-column:1/-1;margin-bottom:20px}
  .sd-body{grid-column:1/-1;display:grid;gap:28px}
  .sd-body h3{margin-bottom:6px}
  .suits,.cats{grid-column:1/-1}
  .suits{display:grid;gap:0;border-top:1.5px solid var(--ink)}
  .suits li{padding:14px 0;border-bottom:1px solid var(--rule);font-weight:500;display:flex;gap:12px}
  .suits li::before{content:"";flex:none;width:10px;height:10px;margin-top:8px;background:var(--citron);border:1.5px solid var(--ink)}
  .cats{display:grid;gap:0;border-top:1.5px solid var(--ink)}
  .cats li{padding:18px 0;border-bottom:1px solid var(--rule);display:grid;gap:4px}
  .seq{display:grid;gap:0;margin-top:8px}
  .seq li{display:grid;grid-template-columns:2.5rem 8rem 1fr;gap:8px;padding:12px 0;border-bottom:1px solid var(--rule);align-items:baseline}
  .sd-enq{grid-column:1/-1;display:grid;gap:16px;align-content:start}
  .sd-enq .btn{justify-self:start}
  .others{display:grid;gap:0;margin-top:16px;border-top:1px solid var(--rule-strong)}
  .others a{display:flex;gap:14px;align-items:baseline;padding:14px 0;border-bottom:1px solid var(--rule);text-decoration:none;color:var(--ink);min-height:52px}
  .others a:hover .display{text-decoration:underline;text-decoration-color:var(--citron);text-decoration-thickness:3px}
  @media (min-width:900px){
    .sd-lede{grid-column:1/8}.sd-spec{grid-column:9/13;margin-top:0}
    .sd-h{grid-column:1/5;margin-bottom:0}.sd-body{grid-column:5/13;grid-template-columns:1fr 1fr;gap:36px 32px}.sd-body.one{grid-template-columns:1fr}
    .suits,.cats{grid-column:5/13}.cats{grid-template-columns:1fr 1fr;column-gap:32px}
    .sd-enq{grid-column:6/13;grid-template-columns:1fr 1fr}.sd-enq .btn{grid-column:1/-1}
    .others{grid-template-columns:repeat(5,1fr);column-gap:24px;border-top:0}.others a{flex-direction:column;gap:4px;border-top:1.5px solid var(--ink)}
  }
  @media (max-width:520px){.seq li{grid-template-columns:2rem 1fr}.seq li span:last-child{grid-column:2}}
</style>
<style is:global>@view-transition{navigation:auto}::view-transition-group(service-hero){animation-duration:.3s;animation-timing-function:cubic-bezier(.22,.8,.24,1)}</style>
