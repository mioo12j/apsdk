---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Human from '../components/Human.astro';
import { faqs, checklist } from '../data/faqs';
const jsonld = [{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }];
---
<Base title="Shipping FAQs: FTL vs PTL, Tracking, POD" description="Answers on tracking, proof of delivery, FTL versus PTL, cold chain, project cargo, PIN-code coverage and API integration, plus a shipping checklist." jsonld={jsonld}>
  <PageHero eyebrow="Help" title="Plain answers before you ship." lede="If your question is not here, the team is a call away." />
  <section class="section-tight" style="padding-top:0">
    <div class="wrap grid">
      <div class="h-faq">
        <h2 class="display h-2">Frequently asked questions</h2>
        <div class="acc" style="margin-top:16px">
          {faqs.map((f) => (
            <details id={f.id} name="faq">
              <summary><span><span class="mono small muted" style="margin-right:10px">{f.topic}</span>{f.q}</span></summary>
              <div class="acc-body stack" style="--s:10px"><p>{f.a}</p><p><a class="link-arrow" href={f.link.href}>{f.link.label} <span aria-hidden="true">→</span></a></p></div>
            </details>
          ))}
        </div>
      </div>
      <aside class="h-side">
        <div class="h-check">
          <h2 class="display h-2">Before you ship: checklist</h2>
          <ol>{checklist.map((c) => <li>{c}</li>)}</ol>
        </div>
        <div class="h-sup dark">
          <h2 class="display h-2">Still need help?</h2>
          <Human lead="" />
          <p><a class="btn btn-primary" href="/contact?topic=shipment">Raise a shipment query</a></p>
        </div>
      </aside>
    </div>
  </section>
  <script>
    // open the FAQ named in the URL hash (works for deep links from search and tracking)
    const open = () => { const el = location.hash && document.getElementById(location.hash.slice(1)); if (el && el.tagName === 'DETAILS') { (el as HTMLDetailsElement).open = true; el.scrollIntoView({ block: 'start' }); } };
    open(); addEventListener('hashchange', open);
  </script>
</Base>
<style>
  .h-faq,.h-side{grid-column:1/-1}
  .h-side{display:grid;gap:20px;margin-top:32px;align-content:start}
  .h-check{background:#fff;border:1.5px solid var(--ink);padding:24px}
  .h-check ol{margin:14px 0 0;padding-left:1.3em;display:grid;gap:10px}
  .h-sup{padding:24px;display:grid;gap:12px}
  details{scroll-margin-top:calc(var(--header-h) + 12px)}
  @media (min-width:1000px){.h-faq{grid-column:1/8}.h-side{grid-column:9/13;margin-top:0}}
</style>
