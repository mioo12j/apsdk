---
import Base from '../layouts/Base.astro';
import TrackForm from '../components/TrackForm.astro';
import Human from '../components/Human.astro';
import LoopVideo from '../components/LoopVideo.astro';
import Cut from '../components/Cut.astro';
---
<Base title="Page not found" description="This page could not be found. Track a shipment, see our services or contact the team." noindex>
  <section class="nf dark">
    <LoopVideo name="van" class="bg nf-bg" label="background video" />
    <div class="wrap nf-in stack" style="--s:22px">
      <p class="mono nf-k">404 · No scan at this address</p>
      <h1 class="display h-page">This page did not arrive.</h1>
      <p class="lede">The link may be old, or the address may have a typing error. These three will get you moving again.</p>
      <p class="cluster"><a class="btn btn-primary" href="/track">Track</a><a class="btn btn-ghost" href="/services">Services</a><a class="btn btn-ghost" href="/contact">Contact</a></p>
      <div class="nf-track"><TrackForm id="nf-track" compact /></div>
      <Human />
    </div>
    <div class="nf-van" aria-hidden="true"><span class="nf-bubble" data-text="Wrong address?"></span><Cut name="van" priority sizes="(min-width:900px) 34vw, 70vw" widths={[400, 800]} /></div>
  </section>
</Base>
<style>
  .nf{position:relative;isolation:isolate;overflow:clip;min-height:calc(100svh - var(--header-h));display:grid;align-items:center}
  .nf :global(.nf-bg){z-index:-1}
  .nf :global(.nf-bg img),.nf :global(.nf-bg video){opacity:.4}
  .nf :global(.loopv-shade){background:linear-gradient(90deg,rgba(11,32,44,.95),rgba(11,32,44,.7) 55%,rgba(11,32,44,.5))}
  .nf-in{position:relative;z-index:2;max-width:820px;padding-block:clamp(48px,8vw,96px)}
  .nf-k{color:var(--citron)}
  .nf-track{background:var(--petrol);padding:20px;border-radius:4px;max-width:560px}
  .nf-van{position:absolute;z-index:1;right:4vw;bottom:8vh;width:min(32vw,460px);pointer-events:none}
  .nf-van :global(img){width:100%;height:auto;animation:nfDrive 2.4s cubic-bezier(.16,.84,.3,1) .3s both;filter:drop-shadow(0 20px 24px rgba(0,0,0,.5))}
  .nf-bubble{position:absolute;right:8%;top:-22%;transform-origin:bottom right;animation:nfPop .5s cubic-bezier(.2,1.6,.35,1) 2.5s both}
  .nf-bubble::before{content:attr(data-text);display:block;padding:10px 16px;border-radius:14px 14px 2px 14px;background:var(--citron);color:var(--ink);font:700 1.25rem/1 var(--display);white-space:nowrap}
  @keyframes nfDrive{0%{transform:translateX(70vw)}80%{transform:translateX(-1.5vw)}92%{transform:translateX(.4vw)}100%{transform:none}}
  @keyframes nfPop{from{opacity:0;transform:scale(.4)}to{opacity:1;transform:none}}
  @media (max-width:899px){.nf-van{display:none}}
</style>
