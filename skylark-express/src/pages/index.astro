---
import Base from '../layouts/Base.astro';
import Pic from '../components/Pic.astro';
import TrackForm from '../components/TrackForm.astro';
import FilmDialog from '../components/FilmDialog.astro';
import IndiaMap from '../components/IndiaMap.astro';
import OfficeData from '../components/OfficeData.astro';
import Founders from '../components/Founders.astro';
import PodExample from '../components/PodExample.astro';
import Cut from '../components/Cut.astro';
import Showreel from '../components/Showreel.astro';
import LoopVideo from '../components/LoopVideo.astro';
import Ticker from '../components/Ticker.astro';
import { company, figures } from '../data/company';
import { services } from '../data/services';
import { offices } from '../data/offices';
import scrub from '../data/generated/scrub.json';

const cutFor: Record<string, string> = { 'road-logistics': 'truck', 'railway-logistics': 'train', 'air-logistics': 'uld', warehousing: 'forklift', 'project-cargo': 'lowloader', packaging: 'crate' };
const homeFigures = [figures.since, figures.warehouses, figures.pinCodes]; // at most three together on Home
const journey = [
  { k: 'Pickup', img: 'film-pickup', alt: 'A hand scans the label of a kraft carton sealed with Skylark tape at a dispatch counter', text: 'The carton is sealed, labelled and scanned at the counter. From this scan onward it has a docket and a named custodian.', ev: '12 Nov, 17:42 IST · Gurugram · Picked up' },
  { k: 'Hub', img: 'film-hub', alt: 'A dock worker in a Skylark jacket places the carton on a trolley beside a scan station', text: 'At the hub dock it is counted off the van, scanned again and staged with the freight travelling the same way.', ev: '12 Nov, 21:10 IST · Gurugram hub · Received and staged' },
  { k: 'Linehaul', img: 'hero-settle', alt: 'The side panel of a Skylark Express truck passing the loading bay', text: 'Road, rail or air: the mode is chosen for the load. Each handover between vehicles is recorded.', ev: '13 Nov, 04:35 IST · Delhi · Departed on linehaul' },
  { k: 'Delivery', img: 'film-delivery', alt: 'A recipient at a factory receiving bay scans the same carton', text: 'The recipient scans the same label at the receiving bay. The signed delivery record closes the docket.', ev: '13 Nov, 12:48 IST · Bengaluru · Delivered' },
];
const published = offices.filter((o) => o.kind !== 'city').length, listed = offices.length - published;
---
<Base title="Home" description="Skylark Express: pan-India logistics company from Gurugram and Delhi since 1993. FTL and PTL road freight, rail, air cargo, warehousing and project cargo.">

  <!-- 01 · Dispatch — layered cut-outs; scrolling flies the freighter out and drives the truck away -->
  <section class="sky" data-sky aria-labelledby="hero-h">
    <script is:inline>(function(){var c=navigator.connection||{};if(!matchMedia('(prefers-reduced-motion:reduce)').matches&&!c.saveData&&innerWidth>=900&&innerHeight>=600)document.currentScript.parentElement.classList.add('is-pin')})();</script>
    <div class="sky-stick">
      <div class="sky-scene" aria-hidden="true">
        <div class="sky-bg"></div>
        <div class="sky-stars"></div>
        <div class="sky-dawn" data-layer="dawn"></div>
        <div class="sky-sun" data-layer="sun"></div>
        <div class="sky-cloud c1" data-layer="c1"></div><div class="sky-cloud c2" data-layer="c2"></div><div class="sky-cloud c3" data-layer="c3"></div>
        <div class="sky-plane" data-layer="plane"><span class="trail"></span><Cut name="plane" class="plane-img" priority sizes="(min-width:900px) 52vw, 78vw" widths={[600, 1000, 1600]} /></div>
        <div class="sky-skyline" data-layer="skyline"><Cut name="skyline" sizes="140vw" widths={[1000, 1600, 2400]} /></div>
        <div class="sky-road"><span class="lane" data-layer="lane"></span></div>
        <div class="sky-truck" data-layer="truck"><span class="tshadow"></span><Cut name="truck" priority sizes="(min-width:900px) 38vw, 80vw" widths={[500, 800, 1200]} /></div>
      </div>
      <div class="wrap sky-copy" data-layer="copy">
        <p class="eyebrow">{company.brandLine}</p>
        <h1 class="display sky-h1" id="hero-h"><span class="ln"><span style="--i:0">From the first</span></span> <span class="ln"><span style="--i:1">pickup to the</span></span> <span class="ln"><span style="--i:2">final handover.</span></span></h1>
        <p class="lede sky-sub">Skylark brings road, rail and air freight together with warehousing, specialist packaging and project cargo across India.</p>
        <div class="hero-panel"><TrackForm id="hero-track" compact /></div>
        <div class="hero-actions">
          <a class="btn btn-ghost" href="/quote">Get a freight quote <span class="arr" aria-hidden="true">→</span></a>
          <a class="link-arrow hero-link" href="#reel">Watch the film <span class="arr" aria-hidden="true">↓</span></a>
        </div>
      </div>
      <p class="sky-hint" aria-hidden="true"><span class="j-mouse"></span>Scroll</p>
    </div>
  </section>

  <!-- 02 · First handover -->
  <section class="section facts" aria-labelledby="facts-h" data-route>
    <span class="route" aria-hidden="true"></span>
    <div class="wrap grid">
      <div class="facts-lead">
        <p class="eyebrow" data-reveal>First handover</p>
        <h2 class="display h-1" id="facts-h" data-reveal>One team, from the plan to the proof of delivery.</h2>
        <p class="lede" data-reveal style="--d:80ms">Skylark combines consultation, planning, implementation and day-to-day execution: first-mile collection, long-distance transport, storage, distribution, final delivery and reverse logistics. Discuss a single service or the whole movement.</p>
      </div>
      <dl class="facts-grid">
        {homeFigures.map((f, i) => (
          <div data-reveal style={`--d:${i * 110}ms`}>
            <dd class="display fig" data-count>{f.value.replace('Since ', '')}{'unit' in f ? <span class="unit"> {f.unit}</span> : <span class="unit"> since</span>}</dd>
            <dt>{f.label}</dt>
          </div>
        ))}
      </dl>
      <p class="small muted facts-note" data-reveal>{figures.note} <a href="/serviceability">Check a PIN code</a></p>
      <div class="facts-carton" data-layer="carton" aria-hidden="true"><span class="cshadow"></span><Cut name="carton" sizes="(min-width:900px) 30vw, 60vw" /></div>
    </div>
  </section>

  <!-- 02a · The film, inline -->
  <div id="reel"><Showreel id="home-reel" /></div>

  <!-- 02b · The right mode for the load — pinned horizontal theatre -->
  <section class="modes" data-modes aria-labelledby="modes-h">
    <script is:inline>(function(){var c=navigator.connection||{};if(!matchMedia('(prefers-reduced-motion:reduce)').matches&&!c.saveData&&innerWidth>=900&&innerHeight>=600)document.currentScript.parentElement.classList.add('is-pin')})();</script>
    <div class="m-stick">
      <header class="wrap m-head">
        <p class="eyebrow">Linehaul</p>
        <h2 class="display h-1" id="modes-h">The right mode for the load.</h2>
        <ol class="m-dots" aria-hidden="true"><li data-dot>Pickup</li><li data-dot>Road</li><li data-dot>Rail</li><li data-dot>Air</li></ol>
      </header>
      <div class="m-track" data-modes-track>
          <article class="m-panel m-van" data-panel={0} aria-labelledby="m-van-h">
            <span class="m-word" aria-hidden="true" data-word data-text="Pickup"></span>
            <div class="m-obj" data-obj aria-hidden="true"><span class="oshadow"></span><Cut name="van" sizes="(min-width:900px) 42vw, 90vw" widths={[500, 900, 1500]} /></div>
            <div class="m-copy"><p class="mono m-k">01 · First mile</p><h3 class="display h-1" id="m-van-h">Collected from your door.</h3><p>A named local vehicle collects from your dock, counts the pieces and scans the docket before it leaves.</p><p><a class="link-arrow" href="/services/road-logistics">Road logistics <span class="arr" aria-hidden="true">→</span></a></p></div>
          </article>
          <article class="m-panel m-truck" data-panel={1} aria-labelledby="m-truck-h">
            <span class="m-word" aria-hidden="true" data-word data-text="Road"></span>
            <div class="m-obj" data-obj aria-hidden="true"><span class="oshadow"></span><Cut name="truck" sizes="(min-width:900px) 42vw, 90vw" widths={[500, 900, 1500]} /></div>
            <div class="m-copy"><p class="mono m-k">02 · Road</p><h3 class="display h-1" id="m-truck-h">Full or part truck load.</h3><p>Full Truck Load (FTL) gives one shipper the vehicle; Part Truck Load (PTL) shares it. Every hub handover is scanned.</p><p><a class="link-arrow" href="/services/road-logistics">FTL and PTL <span class="arr" aria-hidden="true">→</span></a></p></div>
          </article>
          <article class="m-panel m-train" data-panel={2} aria-labelledby="m-train-h">
            <span class="m-word" aria-hidden="true" data-word data-text="Rail"></span>
            <div class="m-obj" data-obj aria-hidden="true"><span class="oshadow"></span><Cut name="train" sizes="(min-width:900px) 60vw, 90vw" widths={[500, 900, 1500]} /></div>
            <div class="m-copy"><p class="mono m-k">03 · Rail</p><h3 class="display h-1" id="m-train-h">Road to rail and back.</h3><p>Road pickup, a consolidated rail leg and road delivery, with the piece count checked at both terminals.</p><p><a class="link-arrow" href="/services/railway-logistics">Railway logistics <span class="arr" aria-hidden="true">→</span></a></p></div>
          </article>
          <article class="m-panel m-plane" data-panel={3} aria-labelledby="m-plane-h">
            <span class="m-word" aria-hidden="true" data-word data-text="Air"></span>
            <div class="m-obj" data-obj aria-hidden="true"><span class="oshadow"></span><Cut name="plane" sizes="(min-width:900px) 60vw, 90vw" widths={[500, 900, 1500]} /></div>
            <div class="m-copy"><p class="mono m-k">04 · Air</p><h3 class="display h-1" id="m-plane-h">When it must arrive by a time.</h3><p>Domestic air cargo with carrier coordination and milestone updates from pickup to delivery.</p><p><a class="link-arrow" href="/services/air-logistics">Air logistics <span class="arr" aria-hidden="true">→</span></a></p></div>
          </article>
      </div>
      <div class="m-ground" aria-hidden="true"><span class="m-lane" data-modes-lane></span></div>
    </div>
  </section>

  <!-- 03 · Follow a consignment — scroll plays the footage -->
  <section class="journey dark" id="journey" aria-labelledby="journey-h" data-journey>
    <script is:inline>
      /* size the scroll sequence before first layout so Back/forward restores the visitor's place */
      (function(){var c=navigator.connection||{};if(!matchMedia('(prefers-reduced-motion:reduce)').matches&&!c.saveData&&!/(^|-)2g/.test(c.effectiveType||'')&&innerHeight>=520)document.currentScript.parentElement.classList.add('is-cine')})();
    </script>
    <div class="j-sticky">
      <div class="j-stage" aria-hidden="true">
        {journey.map((s, i) => <div class:list={['j-frame', { on: i === 0 }]} data-frame={i}><Pic name={s.img} alt="" ratio={16 / 9} widths={[800, 1200, 1600]} sizes="100vw" /></div>)}
        <video class="j-video" muted playsinline preload="none" tabindex="-1" disablepictureinpicture data-journey-video></video>
        <div class="j-shade"></div>
      </div>
      <div class="wrap j-ui">
        <div class="j-head">
          <p class="eyebrow">Follow a consignment</p>
          <h2 class="display h-1" id="journey-h">Four handovers. One docket.</h2>
          <p class="small j-meta"><a class="j-skip" href="#services">Skip shipment journey</a></p>
        </div>
        <ol class="j-steps" role="list">
          {journey.map((s, i) => (
            <li class:list={['j-step', { on: i === 0 }]} data-step={i}>
              <figure class="j-still"><Pic name={s.img} alt={s.alt} ratio={16 / 9} widths={[480, 800]} sizes="92vw" /></figure>
              <div class="j-text">
                <h3 class="display"><span class="mono j-n">0{i + 1}</span>{s.k}</h3>
                <p>{s.text}</p>
                <p class="mono small j-ev">SKX-4471-0926 · {s.ev}</p>
              </div>
            </li>
          ))}
        </ol>
        <div class="j-foot" aria-hidden="true">
          <p class="j-shot"><span data-journey-shot>Scanned at the counter</span></p>
          <div class="j-rail"><span class="j-fill" data-journey-fill></span>{scrub.chapters.map((c) => <span class="j-node" style={`left:${(c.start / scrub.duration) * 100}%`}><b>{c.name}</b></span>)}<span class="j-node end" style="left:100%"></span></div>
          <p class="j-hint"><span class="j-mouse"></span>Scroll to follow the carton</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 04 · Choose a service — lifted objects -->
  <section class="section services" id="services" aria-labelledby="svc-h">
    <div class="wrap">
      <div class="svc-head">
        <p class="eyebrow" data-reveal>Six service lines</p>
        <h2 class="display h-page" id="svc-h" data-reveal>What are you moving?</h2>
        <p class="lede" data-reveal>Discuss a single service or the whole movement. Every page ends with an enquiry that goes to the right team. <a href="/services">Use the service selector</a></p>
      </div>
      <ul class="lift-grid" role="list">
        {services.map((s, i) => (
          <li data-reveal style={`--d:${(i % 3) * 90}ms`}>
            <a class="lift" href={`/services/${s.slug}`} data-tilt>
              <span class="lift-top"><span class="mono">{s.index} / 06</span><span class="mono">{s.spec[0][1]}</span></span>
              <span class="lift-obj" aria-hidden="true" data-cut={cutFor[s.slug]}><span class="lshadow"></span><Cut name={cutFor[s.slug]} sizes="(min-width:1100px) 26vw, (min-width:600px) 44vw, 86vw" widths={[400, 700, 1000]} /></span>
              <span class="display lift-name">{s.name}</span>
              <span class="lift-sum">{s.summary}</span>
              <span class="lift-go" aria-hidden="true">View service <span class="arr">→</span></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Ticker />

  <!-- 05 · The network -->
  <section class="section network dark" aria-labelledby="net-h" data-network="home" data-view="list">
    <OfficeData />
    <div class="wrap grid net-grid">
      <div class="net-copy">
        <p class="eyebrow" data-reveal>The network</p>
        <h2 class="display h-1" id="net-h" data-reveal>Run from Gurugram. Listed in {offices.length} locations.</h2>
        <p class="lede" data-reveal>{published} offices with published addresses and {listed} more listed cities. The map shows listed locations; only a serviceability check confirms a particular PIN code and shipment type.</p>
        <div class="net-tools" data-reveal>
          <form class="field" role="search" aria-label="Find a branch">
            <label for="home-branch">Find a branch</label>
            <input class="input" id="home-branch" type="search" placeholder="City, region or PIN" autocomplete="off" data-branch-search enterkeyhint="search" />
          </form>
          <form class="field" action="/serviceability" method="get">
            <label for="home-pin">Check a PIN code</label>
            <div class="pin-row">
              <input class="input mono" id="home-pin" name="pin" type="text" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" placeholder="6 digits" autocomplete="postal-code" />
              <button class="btn btn-ghost" type="submit">Check</button>
            </div>
          </form>
        </div>
        <p class="sr-only" role="status" aria-live="polite" data-network-status></p>
        <div class="net-results" data-branch-results></div>
        <div class="net-panel" data-office-panel hidden></div>
        <p class="cluster net-links">
          <a class="link-arrow" href="/network">Open the full directory <span class="arr" aria-hidden="true">→</span></a>
          <button class="btn btn-ghost net-toggle" type="button" data-view-btn="map" aria-pressed="false">Show the map</button>
        </p>
      </div>
      <div class="net-map" data-map-view>
        <h3 class="sr-only">Map view of listed locations</h3>
        <IndiaMap id="home-map" />
        <p class="small muted map-cap">Dots mark listed locations at city level. North is up.</p>
      </div>
    </div>
  </section>

  <!-- 06 · The people -->
  <section class="section people petrol" aria-labelledby="people-h">
    <div class="wrap grid people-grid">
      <div class="people-copy">
        <p class="eyebrow" data-reveal>The people</p>
        <h2 class="display h-1" id="people-h" data-reveal>In 1993 the two founders were the whole company.</h2>
        <div class="prose" data-reveal style="--d:80ms">
          <p class="lede">Brothers Rakesh Yadav and Naveen Yadav started without an office or a fleet. They took the bookings themselves, and they made the deliveries themselves.</p>
          <p>Handling the first consignments personally taught them what a customer asks at each handover: who has it now, and when will it arrive? The business they lead today, from Gurugram, is organised around answering those two questions.</p>
          <p><a class="link-arrow" href="/about">Read the Skylark story <span class="arr" aria-hidden="true">→</span></a></p>
        </div>
      </div>
      <div class="people-pics"><Founders /></div>
    </div>
  </section>

  <!-- 07 · Arrival -->
  <section class="section arrival" aria-labelledby="arr-h" data-route="end">
    <span class="route" aria-hidden="true"></span>
    <div class="wrap grid">
      <div class="arr-copy">
        <p class="eyebrow" data-reveal>Arrival</p>
        <h2 class="display h-1" id="arr-h" data-reveal>The journey ends with a record.</h2>
        <p class="lede" data-reveal>When the consignee receives the goods, the delivery is recorded and the proof of delivery (POD) is available to authorised customers.</p>
      </div>
      <div class="arr-pod" data-reveal><div data-reveal class="podx-wrap"><PodExample /></div></div>
    </div>
  </section>

  <section class="closing dark" aria-labelledby="close-h" data-spot>
    <div class="closing-media" data-parallax="8"><LoopVideo name="dusk" class="bg" alt="A Skylark Express truck travelling away along a highway at dusk" label="closing video" /></div>
    <div class="wrap closing-inner">
      <div class="closing-panel" data-reveal>
        <h2 class="display h-page" id="close-h">Tell us what needs to move.</h2>
        <p class="lede">Share the cargo, the pickup point and the destination. Our team will help plan the movement.</p>
        <p class="cluster">
          <a class="btn btn-primary" href="/quote">Get a freight quote <span class="arr" aria-hidden="true">→</span></a>
          <a class="btn btn-ghost" href="/track">Track shipment</a>
        </p>
        <dl class="closing-contact">
          <div><dt>Call</dt><dd>{company.phones.map((p) => <a href={`tel:${p.tel}`}>{p.display}</a>)}</dd></div>
          <div><dt>Email</dt><dd><a href={`mailto:${company.email}`}>{company.email}</a></dd></div>
          <div><dt>Hours</dt><dd>{company.hours.display}</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <FilmDialog />
  <script>import '../scripts/network.ts';</script>
  <script>import '../scripts/home.ts';</script>
</Base>

<style>
  /* ── hero: layered sky ── */
  .sky{position:relative;isolation:isolate;color:var(--paper);background:#071822}
  .sky-stick{position:relative;display:flex;flex-direction:column;overflow:clip}
  .sky-scene{position:relative;order:2;height:clamp(260px,78vw,440px);overflow:hidden}
  .sky-bg{position:absolute;inset:0;background:
    radial-gradient(90% 46% at 80% 82%,rgba(255,196,120,.75) 0%,rgba(226,132,74,.42) 30%,rgba(18,60,70,0) 70%),
    linear-gradient(180deg,#06131b 0%,#0B202C 30%,#123C46 52%,#2c5157 64%,#7d6b55 74%,#d18c55 81%,#e7a160 86%,#0d1d26 86.2%)}
  .sky-stars{position:absolute;inset:0 0 45% 0;background-image:radial-gradient(1px 1px at 12% 18%,#fff8 50%,transparent 51%),radial-gradient(1px 1px at 33% 9%,#fff6 50%,transparent 51%),radial-gradient(1.5px 1.5px at 58% 22%,#fff7 50%,transparent 51%),radial-gradient(1px 1px at 71% 6%,#fff5 50%,transparent 51%),radial-gradient(1px 1px at 86% 28%,#fff6 50%,transparent 51%),radial-gradient(1px 1px at 22% 36%,#fff4 50%,transparent 51%),radial-gradient(1.2px 1.2px at 47% 40%,#fff4 50%,transparent 51%),radial-gradient(1px 1px at 93% 14%,#fff5 50%,transparent 51%);opacity:.8}
  .sky-dawn{position:absolute;inset:0;background:linear-gradient(180deg,rgba(40,90,110,0) 20%,rgba(120,150,150,.35) 62%,rgba(255,190,120,.55) 100%);opacity:0}
  .sky-sun{position:absolute;right:16%;bottom:13%;width:38vmin;height:38vmin;border-radius:50%;background:radial-gradient(circle,rgba(255,214,150,.95) 0%,rgba(255,180,100,.55) 18%,rgba(255,150,80,0) 60%);filter:blur(4px)}
  .sky-cloud{position:absolute;border-radius:50%;background:radial-gradient(closest-side,rgba(246,244,238,.42),rgba(246,244,238,0));filter:blur(18px)}
  .c1{width:46vw;height:9vw;left:-6vw;top:22%}.c2{width:38vw;height:7vw;right:-4vw;top:12%;opacity:.7}.c3{width:30vw;height:6vw;left:40%;top:46%;opacity:.55}
  .sky-plane{position:absolute;left:30%;top:6%;width:66%;transform-origin:50% 50%;will-change:transform;z-index:2}
  .sky-plane :global(img){width:100%;height:auto;animation:float 7s ease-in-out infinite;filter:drop-shadow(0 18px 28px rgba(4,14,20,.35))}
  .trail{position:absolute;right:88%;top:52%;width:16vw;height:2px;background:linear-gradient(90deg,rgba(246,244,238,0),rgba(246,244,238,.4));transform:rotate(8deg);transform-origin:right center;filter:blur(1px)}
  .sky-skyline{position:absolute;left:-30%;right:-30%;bottom:calc(17% - 2px);z-index:3;opacity:.96}
  .sky-skyline :global(img){width:100%;height:auto;display:block}
  .sky-road{position:absolute;left:0;right:0;bottom:0;height:17%;z-index:4;background:linear-gradient(180deg,#0d1d26,#071219)}
  .sky-road .lane{position:absolute;left:0;right:0;top:44%;height:4px;background:repeating-linear-gradient(90deg,var(--citron) 0 64px,transparent 64px 104px);opacity:.9;will-change:transform}
  .sky-truck{position:absolute;right:4%;bottom:6%;width:62%;z-index:5;will-change:transform}
  .sky-truck :global(img){width:100%;height:auto;position:relative;animation:idle 2.6s ease-in-out infinite}
  .tshadow,.oshadow,.lshadow,.cshadow{position:absolute;left:8%;right:8%;bottom:1%;height:9%;border-radius:50%;background:radial-gradient(closest-side,rgba(0,0,0,.55),rgba(0,0,0,0));filter:blur(6px)}
  .sky-copy{order:1;position:relative;z-index:6;display:grid;gap:16px;padding-block:24px 22px;background:linear-gradient(180deg,#06131b,#0a1d27)}
  .sky-h1{font-size:clamp(2.875rem,1.6rem + 6vw,4rem);line-height:.92;letter-spacing:-.01em}
  .sky-h1 .ln{display:block}
  .sky-sub{color:rgba(246,244,238,.88)}
  .hero-panel{background:rgba(18,60,70,.86);padding:16px;border-radius:var(--r);border:1px solid var(--rule-dark);backdrop-filter:blur(8px)}
  .hero-actions{display:flex;flex-wrap:wrap;gap:12px;align-items:center}
  .sky-hint{display:none}
  /* entrance: headline lines rise, the freighter glides in, the truck rolls up to the line */
  .sky-h1 .ln{overflow:hidden;padding-bottom:.1em;margin-bottom:-.1em}
  .sky-h1 .ln>span{display:inline-block;animation:lineUp 1s cubic-bezier(.2,.8,.2,1) both;animation-delay:calc(140ms + var(--i) * 110ms)}
  .sky .eyebrow,.sky-sub,.hero-panel,.hero-actions{animation:fadeUp .8s var(--ease) both}
  .sky .eyebrow{animation-delay:.05s}.sky-sub{animation-delay:.5s}.hero-panel{animation-delay:.6s}.hero-actions{animation-delay:.72s}
