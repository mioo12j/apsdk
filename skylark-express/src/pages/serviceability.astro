---
import Base from '../layouts/Base.astro';
import Human from '../components/Human.astro';
import { integrations } from '../config/integrations';
import { examplePins } from '../data/examples';
const mode = integrations.pin.mode;
---
<Base title="Check Delivery by PIN Code" description="Enter a six-digit Indian PIN code to check whether Skylark Express serves the location. Results are confirmed for your cargo type by our team.">
  <section class="page-hero">
    <div class="wrap pinp">
      <p class="eyebrow">Serviceability</p>
      <h1 class="display h-page">Check a PIN code</h1>
      <p class="lede">A PIN-code result tells you whether a location is served. A branch listing tells you where our offices are. They answer different questions, and both depend on the cargo.</p>
      <form class="pin-form" data-pin-form novalidate action="/serviceability" method="get">
        <div class="field">
          <label for="pin-i">Six-digit PIN code</label>
          <div class="pin-r">
            <input class="input mono" id="pin-i" name="pin" type="text" inputmode="numeric" autocomplete="postal-code" maxlength="6" pattern="[0-9]{6}" aria-describedby="pin-h pin-e" enterkeyhint="search" />
            <button class="btn btn-primary" type="submit">Check PIN code</button>
          </div>
          <p class="hint" id="pin-h">For example, 110015. Leading zeros are kept as typed.</p>
          <p class="err" id="pin-e" role="alert" hidden></p>
        </div>
      </form>
      <div role="status" aria-live="polite" data-pin-out class="pin-out"></div>
      <noscript><div class="notice warn"><p class="notice-h">The PIN check needs JavaScript.</p><Human lead="Ask our team about a PIN code:" /></div></noscript>
      <p><a class="link-arrow" href="/network">Find a branch instead <span aria-hidden="true">→</span></a></p>
    </div>
  </section>
  <script>
    import { cfg, api, esc, humanHTML } from '../scripts/config';
    import { examplePins } from '../data/examples';
    const f = document.querySelector<HTMLFormElement>('[data-pin-form]')!, i = f.querySelector<HTMLInputElement>('input')!, e = f.querySelector<HTMLElement>('.err')!, out = document.querySelector<HTMLElement>('[data-pin-out]')!;
    type R = { status: 'serviceable' | 'unsupported' | 'missing' | 'offline'; area?: string; note?: string; example?: boolean };
    async function look(pin: string): Promise<R> {
      if (cfg.pin.mode === 'offline') { const x = (examplePins as any)[pin]; return x ? { ...x, example: true } : { status: 'offline' }; }
      try { const r = await api(`${cfg.pin.endpoint}?pin=${pin}`); if (r.ok && r.body?.status) return r.body; if (r.status === 404) return { status: 'missing' }; return { status: 'offline' }; } catch { return { status: 'offline' }; }
    }
    const ask = (pin: string) => `<a class="btn btn-ink" href="/contact?topic=sales&pin=${pin}">Ask about this PIN</a>`;
    const view = (pin: string, r: R) => {
      const ex = r.example ? ' <span class="tag example">Example data</span>' : '';
      if (r.status === 'serviceable') return `<div class="notice good" data-pin-state="serviceable"><p class="notice-h">${pin} is serviceable.${ex}</p><p>${esc(r.area || '')}. ${esc(r.note || '')} Heavy, oversized, hazardous and temperature-sensitive cargo is confirmed by the team for each shipment.</p><p class="cluster"><a class="btn btn-primary" href="/quote?destination=${pin}">Get a freight quote to ${pin}</a><a class="link-arrow" href="/quote?pickup=${pin}">Quote a pickup from ${pin} <span aria-hidden="true">→</span></a></p></div>`;
      if (r.status === 'unsupported') return `<div class="notice bad" data-pin-state="unsupported"><p class="notice-h">${pin} is not currently served.${ex}</p><p>${esc(r.area || '')}. ${esc(r.note || '')} A project-specific movement may still be possible.</p><p class="cluster">${ask(pin)}</p>${humanHTML('Or speak to the team:')}</div>`;
      if (r.status === 'missing') return `<div class="notice warn" data-pin-state="missing"><p class="notice-h">We have no record for ${pin}.</p><p>We cannot confirm this PIN online. It may be a new or uncommon code. Our team can check it for your shipment.</p><p class="cluster">${ask(pin)}</p>${humanHTML('')}</div>`;
      return `<div class="notice warn" data-pin-state="offline"><p class="notice-h">We cannot confirm ${pin} online right now.</p><p>The PIN lookup is unavailable, so this is not a yes or a no. Our team can confirm it for your shipment.</p><p class="cluster">${ask(pin)}<button class="btn btn-ghost" type="button" data-pin-retry>Try again</button></p>${humanHTML('')}</div>`;
    };
    async function run(raw: string) {
      const pin = raw.trim(); // preserved as text
      if (!/^\d{6}$/.test(pin)) { e.textContent = pin ? 'An Indian PIN code has exactly six digits.' : 'Enter a six-digit PIN code.'; e.hidden = false; i.setAttribute('aria-invalid', 'true'); i.focus(); out.innerHTML = ''; return; }
      if (pin[0] === '0') { e.textContent = 'Indian PIN codes start with a digit from 1 to 8. Check the first digit.'; e.hidden = false; i.setAttribute('aria-invalid', 'true'); i.focus(); out.innerHTML = ''; return; }
      e.hidden = true; i.removeAttribute('aria-invalid'); history.replaceState(null, '', '/serviceability');
      out.innerHTML = '<p class="trk-loading"><span class="spin" aria-hidden="true"></span>Checking…</p>';
      out.innerHTML = view(pin, await look(pin));
      out.querySelector('[data-pin-retry]')?.addEventListener('click', () => run(pin));
    }
    f.addEventListener('submit', (ev) => { ev.preventDefault(); run(i.value); });
    i.addEventListener('input', () => { i.value = i.value.replace(/\D/g, '').slice(0, 6); e.hidden = true; i.removeAttribute('aria-invalid'); });
    const q = new URLSearchParams(location.search).get('pin'); if (q !== null) { i.value = q.replace(/\D/g, '').slice(0, 6); run(q); }
  </script>
</Base>
<style>
  .pinp{display:grid;gap:22px;max-width:820px}
  .pin-r{display:grid;gap:10px}
  @media (min-width:520px){.pin-r{grid-template-columns:minmax(0,14rem) auto;justify-content:start}}
  .pin-out{display:grid;gap:12px}
  .pin-ex{border-top:1px solid var(--rule-strong);padding-top:18px;display:grid;gap:8px}
  .ex-a{min-height:44px;display:inline-flex;align-items:center;padding:0 4px}
</style>
<style is:global>.trk-loading{display:flex;gap:12px;align-items:center;font-weight:600}.spin{width:20px;height:20px;border:3px solid var(--rule);border-top-color:var(--ink);border-radius:50%;animation:spin .8s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}</style>
