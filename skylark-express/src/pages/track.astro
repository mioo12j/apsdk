---
import Base from '../layouts/Base.astro';
import Human from '../components/Human.astro';
import { integrations } from '../config/integrations';
import { exampleShipments } from '../data/examples';
const mode = integrations.tracking.mode;
---
<Base title="Track a Shipment: Docket or AWB Tracking" description="Track your Skylark Express consignment with its docket or air waybill (AWB) number. See the latest scan, city, mode and proof of delivery.">
  <section class="page-hero">
    <div class="wrap trk">
      <h1 class="display h-page">Track a shipment</h1>
      <form class="trk-form" action="/track" method="get" data-track novalidate>
        <div class="field">
          <label for="trk-n">Docket or AWB number</label>
          <div class="trk-row">
            <input class="input mono" id="trk-n" name="number" type="text" autocomplete="off" autocapitalize="characters" spellcheck="false" maxlength="140" aria-describedby="trk-h trk-e" enterkeyhint="search" />
            <button class="btn btn-primary" type="submit">Track shipment</button>
          </div>
          <p class="hint" id="trk-h">An air waybill (AWB) is the number for air cargo. Track up to five numbers by separating them with commas. A customer reference can be used when your account supports it.</p>
          <p class="err" id="trk-e" role="alert" hidden></p>
        </div>
      </form>
      <div class="trk-status" role="status" aria-live="polite" data-track-status></div>
      <div class="trk-out" data-track-out></div>
      <noscript><div class="notice warn"><p class="notice-h">Tracking needs JavaScript in your browser.</p><Human lead="Contact our team with your docket number:" /></div></noscript>
      <section class="trk-help" aria-labelledby="trk-help-h">
        <h2 class="display h-3" id="trk-help-h">Need help with a shipment?</h2>
        <Human lead="Contact our team with your docket number:" />
        <p class="cluster"><a class="link-arrow" href="/contact?topic=shipment" data-query-link>Raise a shipment query <span aria-hidden="true">→</span></a><a class="link-arrow" href="/help#tracking">Tracking help <span aria-hidden="true">→</span></a><a class="link-arrow" href="/technology">How tracking works <span aria-hidden="true">→</span></a></p>
      </section>
      <section class="trk-ex" aria-labelledby="trk-ex-h">
        <h2 class="display h-3" id="trk-ex-h">See an example <span class="tag example">Example data</span></h2>
        <p class="small muted">These fictitious numbers show what each status looks like. They are not real shipments.{mode === 'offline' && ' Live tracking is not connected in this build, so only these examples return a result.'}</p>
        <p class="cluster">{exampleShipments.map((s) => <a class="mono ex-a" href={`/track?number=${s.number}`}>{s.number}<span class="sr-only">, example: {s.statusLabel}</span></a>)}</p>
      </section>
    </div>
  </section>
  <script>import '../scripts/track.ts';</script>
</Base>
<style>
  .trk{display:grid;gap:24px;max-width:920px}
  .trk-row{display:grid;gap:10px}
  @media (min-width:560px){.trk-row{grid-template-columns:1fr auto}}
  .trk-out{display:grid;gap:20px;min-height:8px}
  .trk-help,.trk-ex{border-top:1px solid var(--rule-strong);padding-top:20px;display:grid;gap:10px}
  .ex-a{min-height:44px;display:inline-flex;align-items:center;padding:0 4px}
</style>
<style is:global>
  .trk-card{background:#fff;border:1.5px solid var(--ink);padding:clamp(16px,3vw,28px);display:grid;gap:16px}
  .trk-card h2{display:flex;flex-wrap:wrap;gap:8px 14px;align-items:center}
  .st{display:inline-flex;align-items:center;gap:8px;padding:6px 12px;border-radius:999px;font:600 .875rem/1.2 var(--body);border:1.5px solid}
  .st::before{content:"";width:10px;height:10px;border-radius:50%;background:currentColor}
  .st.in-transit{color:#00566B}.st.delivered{color:#1C6B3F}.st.delivered::before{border-radius:2px}.st.exception{color:#A3261C}.st.exception::before{border-radius:0;transform:rotate(45deg)}.st.collection-pending{color:#6B4A00}.st.collection-pending::before{background:none;border:2px solid currentColor}
  .trk-latest{display:grid;gap:12px;grid-template-columns:repeat(2,1fr);border-block:1px solid var(--rule);padding-block:14px}
  @media (min-width:640px){.trk-latest{grid-template-columns:repeat(4,1fr)}}
  .trk-latest dt{font:600 .6875rem/1.3 var(--body);letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
  .trk-latest dd{font-weight:600}
  .tl{display:grid;gap:0;border-left:2px solid var(--rule-strong);margin-left:6px}
  .tl li{position:relative;padding:0 0 16px 20px}
  .tl li::before{content:"";position:absolute;left:-7px;top:6px;width:12px;height:12px;border-radius:50%;background:#fff;border:2px solid var(--ink)}
  .tl li:first-child::before{background:var(--citron)}
  .tl time{display:block;font-size:.8125rem;color:var(--muted)}
  .trk-pod{display:grid;gap:10px;border-top:1px solid var(--rule);padding-top:14px}
  .trk-pod form{display:grid;gap:10px;max-width:460px}
  .trk-loading{display:flex;gap:12px;align-items:center;font-weight:600}
  .spin{width:20px;height:20px;border:3px solid var(--rule);border-top-color:var(--ink);border-radius:50%;animation:spin .8s linear infinite}
  @keyframes spin{to{transform:rotate(360deg)}}
</style>
