---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Pic from '../components/Pic.astro';
import PodExample from '../components/PodExample.astro';
import CTA from '../components/CTA.astro';
const items = [
  ['Scan-based tracking', 'Each piece carries a barcode label. It is scanned at pickup, at every hub and at delivery, so the tracking page shows where the consignment last changed hands and when.'],
  ['Digital dockets', 'The docket, the consignment’s reference document, is created digitally at booking. The same number follows the consignment on every label and every scan.'],
  ['E-way bills', 'Where the law requires an e-way bill for the movement of goods, its number is recorded against the docket and travels with the consignment.'],
  ['Proof of delivery (POD)', 'The consignee’s receipt is recorded at the door. Authorised customers can view or download the POD from the tracking result when it exists.'],
  ['Milestone notifications', 'Updates at pickup, dispatch, arrival and delivery, and when a delivery attempt fails, can be sent to the contacts you nominate.'],
  ['Booking, tracking and POD API', 'An application programming interface (API) lets your systems create bookings, read tracking events and retrieve PODs. Scope and method are agreed with your technical team.'],
  ['ERP integration', 'Enterprise resource planning (ERP) systems can exchange booking and delivery data with ours, so dispatch teams do not re-key consignments.'],
  ['Operations reporting', 'Reports on dispatches, deliveries, exceptions and stock can be shared on the schedule you need.'],
];
const events = [['12 Nov 17:42 IST', 'Gurugram', 'Picked up', 'Label scanned at dispatch counter'], ['12 Nov 21:10 IST', 'Gurugram hub', 'Received', 'Staged for air linehaul'], ['13 Nov 04:35 IST', 'Delhi', 'Departed', 'On flight'], ['13 Nov 07:20 IST', 'Bengaluru', 'Arrived', 'Destination airport'], ['13 Nov 12:48 IST', 'Bengaluru', 'Delivered', 'Received at factory receiving bay']];
---
<Base title="Technology" description="How Skylark Express uses scan-based tracking, digital dockets, e-way bills, proof of delivery, notifications, API and ERP integration, and operations reporting.">
  <PageHero eyebrow="Technology" title="A scan at every handover." lede="The technology has one job: to answer who has the consignment now, and when it will arrive." />
  <section class="section-tight" style="padding-top:0">
    <div class="wrap grid">
      <div class="tech-pic" data-reveal="mask"><Pic name="scan-station" alt="A carton passes under a fixed barcode scanner at a hub scan station beside a handheld terminal" ratio={16 / 9} widths={[640, 1024, 1600]} sizes="(min-width:900px) 60vw, 92vw" /></div>
      <ol class="tech-list" role="list">{items.map(([k, v], i) => <li data-reveal><span class="mono small">{String(i + 1).padStart(2, '0')}</span><div><h2 class="display h-3">{k}</h2><p>{v}</p></div></li>)}</ol>
    </div>
  </section>
  <section class="section-tight dark" aria-labelledby="ev-h">
    <div class="wrap grid">
      <div class="ev-l stack" style="--s:14px"><p class="eyebrow">Delivery events</p><h2 class="display h-1" id="ev-h">What a delivery event looks like</h2><p>Every scan produces one event: a time with its timezone, a place, a status and a note. This labelled illustration uses a fictitious consignment.</p><p><span class="tag example">Example data</span></p></div>
      <figure class="ev-fig">
        <table class="ev"><caption class="sr-only">Illustrative delivery events for example docket EXAMPLE-1004</caption>
          <thead><tr><th scope="col">Scan time</th><th scope="col">Place</th><th scope="col">Status</th><th scope="col">Note</th></tr></thead>
          <tbody>{events.map((e) => <tr><td class="mono">{e[0]}</td><td>{e[1]}</td><td><strong>{e[2]}</strong></td><td>{e[3]}</td></tr>)}</tbody></table>
        <figcaption>Docket EXAMPLE-1004. <a href="/track?number=EXAMPLE-1004">Open this example on the tracking page</a></figcaption>
      </figure>
    </div>
  </section>
  <section class="section-tight" aria-labelledby="podt-h">
    <div class="wrap grid">
      <div class="ev-l stack" style="--s:14px"><h2 class="display h-2" id="podt-h">The record that closes the docket</h2><p>A proof of delivery shows what was received, where, and when. It is released to the shipper, the consignee and their authorised users, and is kept out of public search results.</p></div>
      <div class="ev-fig" data-reveal><PodExample /></div>
    </div>
  </section>
  <CTA title="Planning an integration?" text="Tell us which system you use and what you want to exchange: bookings, tracking events, PODs or reports." href="/contact?topic=integration" label="Send an integration enquiry" />
</Base>
<style>
  .tech-pic,.tech-list,.ev-l,.ev-fig{grid-column:1/-1}
  .tech-pic :global(img){width:100%}
  .tech-list{margin-top:28px;border-top:1.5px solid var(--ink)}
  .tech-list li{display:grid;grid-template-columns:2.4rem 1fr;gap:8px;padding:18px 0;border-bottom:1px solid var(--rule)}
  .tech-list h2{margin-bottom:4px}
  .ev-fig{margin-top:24px;overflow-x:auto}
  .ev{width:100%;border-collapse:collapse;min-width:520px}
  .ev th{text-align:left;font:600 .75rem var(--body);letter-spacing:.12em;text-transform:uppercase;color:var(--cyan);padding:10px 12px 10px 0;border-bottom:1.5px solid var(--paper)}
  .ev td{padding:12px 12px 12px 0;border-bottom:1px solid var(--rule-dark);vertical-align:top}
  .ev tr:last-child td{border-bottom:0}.ev tr:last-child strong{background:var(--citron);color:var(--ink);padding:2px 6px}
  @media (min-width:900px){.tech-pic{grid-column:1/8;position:sticky;top:calc(var(--header-h) + 24px);align-self:start}.tech-list{grid-column:8/13;margin-top:0}.ev-l{grid-column:1/5}.ev-fig{grid-column:6/13;margin-top:0}}
</style>
