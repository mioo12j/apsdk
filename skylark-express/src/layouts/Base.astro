---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { company } from '../data/company';
import { ORIGIN } from '../data/site';
import { integrations } from '../config/integrations';
interface Props { title: string; description: string; path?: string; noindex?: boolean; ogImage?: string; ogAlt?: string; preloadImage?: string; jsonld?: object[]; bare?: boolean; crumbs?: { name: string; href: string }[] }
const { title, description, path = Astro.url.pathname, noindex = false, ogImage = '/brand/og-skylark-express.jpg', ogAlt = 'A Skylark Express truck leaving a loading bay before sunrise, with the line “From the first pickup to the final handover.”', jsonld = [], crumbs } = Astro.props;
const clean = path === '/' ? '/' : path.replace(/\/$/, '');
const canonical = ORIGIN + clean;
const preview = integrations.siteMode === 'preview';
const fullTitle = clean === '/' ? 'Skylark Express | Logistics Company in Delhi NCR, Since 1993' : /Skylark/.test(title) ? title : `${title} | ${company.name}`;
const ogAbs = /^https?:/.test(ogImage) ? ogImage : ORIGIN + ogImage;
const website = { '@context': 'https://schema.org', '@type': 'WebSite', '@id': ORIGIN + '/#website', url: ORIGIN + '/', name: company.name, inLanguage: 'en-IN', publisher: { '@id': ORIGIN + '/#organization' } };
const breadcrumb = clean === '/' || noindex ? null : { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ name: 'Home', href: '/' }, ...(crumbs ?? [{ name: title.split(':')[0], href: clean }])].map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: ORIGIN + (c.href === '/' ? '/' : c.href) })) };
const webpage = { '@context': 'https://schema.org', '@type': clean === '/about' ? 'AboutPage' : clean === '/contact' ? 'ContactPage' : 'WebPage', '@id': canonical + '#webpage', url: canonical, name: fullTitle, description, inLanguage: 'en-IN', isPartOf: { '@id': ORIGIN + '/#website' }, primaryImageOfPage: ogAbs };
const org = {
  '@context': 'https://schema.org', '@type': ['Organization', 'LocalBusiness'], image: ORIGIN + '/brand/og-skylark-express.jpg', telephone: '+911141666666', priceRange: '₹₹', areaServed: { '@type': 'Country', name: 'India' }, knowsAbout: ['Full Truck Load', 'Part Truck Load', 'Rail freight', 'Air cargo', 'Warehousing', 'Project cargo', 'Over-dimensional cargo', 'Industrial packaging'], openingHoursSpecification: { '@type': 'OpeningHoursSpecification', dayOfWeek: company.hours.days, opens: company.hours.opens, closes: company.hours.closes }, '@id': ORIGIN + '/#organization', name: company.legalName, alternateName: company.name,
  url: ORIGIN + '/', logo: ORIGIN + '/brand/skylark-express-logo.png', foundingDate: '1993', slogan: company.brandLine, email: company.email,
  founders: [{ '@type': 'Person', name: 'Rakesh Yadav', jobTitle: 'Chief Managing Director' }, { '@type': 'Person', name: 'Naveen Yadav', jobTitle: 'Managing Director' }],
  address: { '@type': 'PostalAddress', streetAddress: 'Sector 17–18 Divider Road, Sector 18', addressLocality: 'Gurugram', addressRegion: 'Haryana', postalCode: '122022', addressCountry: 'IN' }, geo: { '@type': 'GeoCoordinates', latitude: 28.4925, longitude: 77.07 },
  contactPoint: company.phones.map((p) => ({ '@type': 'ContactPoint', telephone: p.tel, contactType: 'customer service', areaServed: 'IN', availableLanguage: ['en', 'hi'], hoursAvailable: { '@type': 'OpeningHoursSpecification', dayOfWeek: company.hours.days, opens: company.hours.opens, closes: company.hours.closes } })),
};
---
<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en-IN" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="geo.region" content="IN-HR" /><meta name="geo.placename" content="Gurugram" />
    {(noindex || preview) ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}
    <meta name="theme-color" content="#0B202C" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/barlow-condensed-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={company.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogAbs} />
    <meta property="og:image:alt" content={ogAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_IN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogAbs} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <slot name="head" />
    <script type="application/ld+json" set:html={JSON.stringify([org, website, webpage, ...(breadcrumb ? [breadcrumb] : []), ...jsonld])} />
    <script is:inline>(function(d){d.classList.add('js');try{if(localStorage.getItem('skylark.motion')==='off')d.dataset.motion='off'}catch(e){}})(document.documentElement)</script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to main content</a>
    <Header />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer />
    {!['/track', '/quote'].includes(clean) && (
      <nav class="mbar" aria-label="Quick actions" data-mbar>
        <a href="/track"><svg width="18" height="18" viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="6" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M13 13l5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>Track</a>
        <a class="mbar-primary" href="/quote">Get a quote</a>
        <a href={`tel:${company.phones[0].tel}`}><svg width="18" height="18" viewBox="0 0 20 20" aria-hidden="true"><path d="M5 2h3l1.5 4-2 1.3a10 10 0 0 0 5.2 5.2l1.3-2L18 12v3a2 2 0 0 1-2 2A14 14 0 0 1 3 4a2 2 0 0 1 2-2z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>Call</a>
      </nav>
    )}
    <dialog class="search-dialog" data-search aria-label="Search the site">
      <form class="sd-head" role="search" onsubmit="return false">
        <label class="sr-only" for="site-search">Search pages, services, branches and help</label>
        <input class="input" id="site-search" type="search" placeholder="Search pages, services, branches, help" autocomplete="off" enterkeyhint="search" />
        <button class="close-x" type="button" data-search-close>Close</button>
      </form>
      <div class="sd-results" data-search-results role="region" aria-live="polite" aria-label="Search results"><p class="small muted" style="padding:12px">Try “Bangalore”, “PTL”, “cold chain” or “proof of delivery”.</p></div>
    </dialog>
    <script>import '../scripts/site.ts';</script>
  </body>
</html>
